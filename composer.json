{
    "name": "ttpryg/promotion-engine",
    "description": "Framework-agnostic PHP 8.1+ Promotion, Coupon, and Discount Engine for E-commerce & Bookings",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Toto",
            "email": "totoprayogo1916@gmail.com",
            "homepage": "https://ttpryg.my.id"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "psr/event-dispatcher": "^1.0"
    },
    "require-dev": {
        "laravel/pint": "^1.20",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Ttpryg\\PromotionEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ttpryg\\PromotionEngine\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "fix:check": "vendor/bin/pint --test",
        "fix": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
